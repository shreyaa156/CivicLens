# ─────────────────────────────────────────────────────────────
# CivicLens configuration — copy to .env and fill in.
# NEVER commit .env. All secrets stay on the backend.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API (dev: Vite on 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when running behind a reverse proxy / load balancer (for correct rate limiting)
TRUST_PROXY=false

# ── Google Gemini (the only AI provider) ─────────────────────
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Any Gemini model with image understanding + function calling
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated backups used automatically when the primary is overloaded (503/429) or times out.
# Leave empty to disable fallback.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# auto = Gemini when GEMINI_API_KEY is set, otherwise labelled development mode
# gemini = always Gemini (fails clearly if key missing) | development = always sample responses
AI_MODE=auto
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_MS=60000

# ── Agent behaviour ──────────────────────────────────────────
DUPLICATE_RADIUS_METERS=75
DUPLICATE_LOOKBACK_DAYS=60
REVIEW_CONFIDENCE_THRESHOLD=0.6

# ── Admin ────────────────────────────────────────────────────
# Long random string. Required in production; optional in development.
ADMIN_TOKEN=

# ── Storage (paths relative to /server) ──────────────────────
DATABASE_PATH=./data/civiclens.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8

# ── Rate limits (per IP, per window) ─────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REPORT_RATE_LIMIT_MAX=20
CONTACT_RATE_LIMIT_MAX=5

# ── Reverse geocoding (OpenStreetMap Nominatim, free) ────────
GEOCODING_ENABLED=true
GEOCODING_USER_AGENT=CivicLens/1.0 (civic issue reporting app)

# ── Map tiles (public settings, safe to expose to the browser) ──
# Default: official OpenStreetMap tile server (light use only, attribution required).
# To switch provider, set these (no code change or rebuild needed), e.g. CARTO:
#   MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
#   MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
#   MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_SUBDOMAINS=
MAP_TILE_MAX_ZOOM=
