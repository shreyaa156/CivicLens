{
  "name": "civiclens-server",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=./src --watch-path=../.env src/index.js",
    "test": "vitest run",
    "test:report": "vitest run && node scripts/build-test-report.js",
